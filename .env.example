# ============================================================================
# DecodeLabs Project 3: The Persistent Vault API
# Environment Configuration Template (.env.example)
#
# Instructions: Copy this file to '.env' and customize settings as needed.
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (Embedded SQLite with WAL Mode)
DATABASE_PATH=data/vault.db
DB_ENABLE_WAL=true
DB_FOREIGN_KEYS=true

# Security Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
JWT_SECRET=your_jwt_secret_key_here_min_32_chars_for_vault_auth

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info
